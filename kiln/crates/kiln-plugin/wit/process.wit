package kiln:extension@1.1.0;

/// Runs programs, when the plugin's grants allow them.
interface process {
    use types.{error};

    record output {
        /// The exit code; none when a signal ended the program, as when the host killed it for
        /// writing past the cap.
        status: option<s32>,
        /// What it wrote, cut at the host's cap (16 MiB by default) for each stream.
        stdout: list<u8>,
        stderr: list<u8>,
    }

    /// Runs `program` with `args` to completion, feeding it `stdin`.
    ///
    /// `program` is a name the plugin was granted as `process.spawn:<program>`: what runs is the
    /// file the grant was bound to, by the absolute path recorded then, never the name looked
    /// up again. If that file changed or went since, the grant is suspended until the user
    /// grants it again, and nothing runs. `args` reach the program as they are, never through a
    /// shell. The environment holds only these. On Unix: `PATH` (the system's), `HOME`, `LANG`,
    /// `LC_*`, `TMPDIR` and `TERM`. On Windows: `PATH` (`%SystemRoot%\System32;%SystemRoot%;
    /// %SystemRoot%\System32\Wbem`), `SystemRoot`, `windir`, `SystemDrive`, `USERPROFILE`,
    /// `APPDATA`, `LOCALAPPDATA`, `TEMP`, `TMP`, `PATHEXT`, `ProgramData`,
    /// `NUMBER_OF_PROCESSORS` and `PROCESSOR_ARCHITECTURE`.
    ///
    /// Fails with `denied` when no grant allows the program or it is suspended, and with
    /// `failed` when it can't be started, or runs past the host's deadline (10 s) and is killed.
    spawn: func(program: string, args: list<string>, stdin: option<list<u8>>) -> result<output, error>;

    /// How a started program ended.
    record exit {
        /// The exit code; none when a signal ended it.
        code: option<s32>,
        /// Whether the host ended it: by `kill`, or as its job was cancelled or timed out.
        killed: bool,
    }

    /// What `child.read` returns.
    record chunk {
        /// What came from each stream since the last read: at most `max-bytes`, possibly nothing.
        stdout: list<u8>,
        stderr: list<u8>,
        /// Set once the program has exited and both streams are drained: then every later read
        /// returns nothing more, and the same `exited`. A stream ends once everything holding it
        /// has closed it: a program the program started that still holds its output keeps
        /// `exited` unset until it exits too, or `kill` ends it.
        exited: option<exit>,
    }

    /// A program `start` started, and everything it started: a process tree.
    ///
    /// The host buffers at most 1 MiB of each stream (stdout, stderr and stdin). When a buffer of
    /// output is full the host stops reading that stream, so the program blocks on its next write
    /// until the plugin reads: a plugin that reads slowly slows the program, and never grows the
    /// host's memory. There is no cap on the total output. Dropping a child ends its tree, as
    /// `kill` does. A child lives no longer than its job.
    resource child {
        /// Waits up to `timeout-ms` for output, then returns at most `max-bytes` (and at most
        /// 1 MiB) of each stream: what has come so far, possibly nothing. Waits no longer than
        /// the job may run. Fails with `failed("cancelled")` once the job is being cancelled or
        /// is past its wall time.
        read: func(max-bytes: u32, timeout-ms: u32) -> result<chunk, error>;
        /// Writes to its stdin without waiting; returns how many bytes it took: fewer when the
        /// stdin buffer is full, possibly none. Fails with `failed` once stdin is closed: by
        /// `close-stdin`, or once writing to the program failed because it exited or closed its
        /// stdin. Bytes taken before the host learned that never reach it.
        write: func(bytes: list<u8>) -> result<u64, error>;
        /// Closes its stdin once what `write` took has reached the program.
        close-stdin: func();
        /// Ends the program and everything it started at once (SIGKILL to its process group
        /// on Unix, its job object terminated on Windows). Its output so far can still be read.
        /// Once the job is being stopped the host is already ending the tree, and this adds
        /// nothing: SIGKILL comes when the job's grace is up.
        kill: func();
    }

    /// Starts `program` with `args` as `spawn` does (the same grant, bound path, no shell and
    /// environment), its stdin, stdout and stderr streamed through the `child`, without waiting.
    ///
    /// `cwd` is the directory it starts in: a guest path inside a root the plugin's fs grant
    /// preopened, `invalid-argument` if it isn't absolute or has a `.` or `..` part, and `denied`
    /// outside every root, or when a link on the way leads out of it; none starts it where the
    /// app runs. The roots are the preopens themselves: each is the directory its preopen holds,
    /// whatever its path names later, and one whose preopen failed is none. The path is resolved
    /// below the root's open directory, and on Unix the program starts in that open directory.
    ///
    /// `cwd` is a convenience, not a security boundary: the granted program runs unsandboxed
    /// with the user's rights and can change directory anywhere itself. **On Windows one window
    /// stays open:** `CreateProcess` takes its directory as a path, so the host launches by path
    /// after checking it again, and a directory replaced between that check and the program's
    /// own `chdir` can start it elsewhere.
    ///
    /// Only in a background job: in any other call it fails with
    /// `denied("process.start runs only in a background job")`. A job has at most 8 children at
    /// once, counted until each is dropped; past that `start` fails with
    /// `failed("too many programs started in this job")`. When the job is cancelled or runs past
    /// its wall time, every child tree gets SIGTERM on Unix, and SIGKILL 2 s later; on Windows
    /// its job object is terminated at once. When the job ends, children it left are ended the
    /// same way. Fails with `denied` as `spawn` does, and with `failed` when it can't start.
    start: func(program: string, args: list<string>, cwd: option<string>) -> result<child, error>;
}
