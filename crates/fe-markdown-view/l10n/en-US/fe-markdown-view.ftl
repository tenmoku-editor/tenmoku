# fe-markdown-view's messages: why a Markdown image or diagram isn't drawn.

markdown-view-image-remote-blocked = Remote image blocked
markdown-view-image-outside-blocked = Image outside the workspace blocked
markdown-view-image-svg-links-blocked = Image linking files outside the workspace blocked

# Why a ```mermaid fence in the preview is shown as code, under it.
# $kind is the diagram's type as Mermaid names it, such as "zenuml".
markdown-view-diagram-unsupported = { $kind } diagrams aren't drawn yet
# $reason is the diagram library's message, in English.
markdown-view-diagram-failed = Can't draw this diagram: { $reason }
markdown-view-diagram-over-budget = This diagram is too big to draw
markdown-view-diagram-too-large = This diagram is over 64 KiB, so it isn't drawn
markdown-view-diagram-panicked = Drawing this diagram failed
