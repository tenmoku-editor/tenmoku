package fastedit:editor@1.1.0;

/// Panels a plugin shows in the editor's docks, as a declarative view tree the host renders: no
/// webviews, no colours or fonts. Every import needs the `panels` capability, and `panel` is one
/// the plugin's manifest declares in `[[contributes.plugin.panels]]`.
///
/// The host validates a view before it takes it, and refuses an invalid one whole, leaving the
/// last good view shown (`invalid-argument`). Limits: 10,000 nodes per view, depth 32, 16 KiB of
/// text per node, 1 MiB of text per view, 8 panels per plugin, and 20 updates a second per panel,
/// coalesced so the latest view wins.
interface panels {
    use kiln:extension/types@1.1.0.{error, command-id};

    /// A theme token, never a colour.
    enum tone {
        normal,
        muted,
        accent,
        success,
        warning,
        error,
    }

    record text-node {
        text: string,
        tone: tone,
        /// The editor's font.
        mono: bool,
        wrap: bool,
    }

    /// Every interactive node carries a non-empty `label`, its accessible name.
    record button-node {
        label: string,
        /// A name in the app's icon set; an unknown one shows nothing.
        icon: option<string>,
        /// Run as the plugin when the button is pressed.
        command: option<command-id>,
        enabled: bool,
    }

    record toggle-node {
        label: string,
        on: bool,
        enabled: bool,
    }

    record input-node {
        label: string,
        value: string,
        placeholder: option<string>,
    }

    /// A virtualized list; its children are its rows.
    record list-node {
        label: string,
        multi-select: bool,
    }

    /// A tree row; its children are its nodes. `expanded` with no children asks the plugin
    /// through `panel-event.expanded`, so a big tree loads lazily.
    record tree-item-node {
        label: string,
        icon: option<string>,
        expandable: bool,
        expanded: bool,
        detail: option<string>,
        tone: tone,
    }

    variant node-kind {
        column,
        row,
        scroll,
        heading(string),
        text(text-node),
        icon(string),
        badge(text-node),
        button(button-node),
        toggle(toggle-node),
        input(input-node),
        %list(list-node),
        tree-item(tree-item-node),
        separator,
        /// Percent done, 0 to 100; none is indeterminate.
        progress(option<u8>),
    }

    /// `id` is the plugin's own, unique in the view. Only `column`, `row`, `scroll`, `list` and
    /// `tree-item` have children.
    record node {
        id: string,
        kind: node-kind,
        /// Indices into the view's `nodes`; each node is the child of at most one other.
        children: list<u32>,
    }

    /// The tree as a flat arena: `nodes[0]` is the root.
    record view {
        nodes: list<node>,
    }

    /// Replaces panel `panel`'s view.
    set-view: func(panel: string, view: view) -> result<_, error>;

    /// Replaces the subtree at node `id` of the panel's current view with `view`'s root and
    /// what is under it.
    patch: func(panel: string, id: string, view: view) -> result<_, error>;

    /// Shows the panel and focuses it, only while a command the user ran is being handled.
    reveal: func(panel: string) -> result<_, error>;
}

/// What the host tells a plugin about a panel. A plugin that shows panels exports it; the host
/// queues the events it has not delivered, with a cap.
///
/// `tick` and `key` are the realtime pair, for a panel whose
/// `[[contributes.plugin.panels]]` entry sets `tick_ms` or `keys = true`. Both need the
/// `panels.realtime` capability, and a plugin that sets either without it is refused at load.
/// The host owns focus throughout: neither is ever delivered to a panel that is not shown and
/// focused, so a plugin cannot run a loop unseen and there is no idle cost.
interface panel-handler {
    /// A key pressed while the panel is focused. There is no text input here: a panel that
    /// wants typing uses an `input` node.
    ///
    /// The host keeps these, and a plugin never sees them:
    /// - `escape`, which returns focus to the editor; it always does, in every panel;
    /// - `tab`, which moves focus on;
    /// - anything with `secondary`, the platform's command modifier, which is the host's
    ///   whatever the key is. (A game panel may be given these later, for a key that is not a
    ///   registered command; today it is not.)
    record key-event {
        /// The host's key name, as `escape`, `f1` or `a`; compared without case.
        key: string,
        shift: bool,
        ctrl: bool,
        alt: bool,
        /// The platform's command modifier: `cmd` on macOS, `ctrl` elsewhere.
        secondary: bool,
    }

    variant panel-event {
        /// A button pressed, or a tree item or list row opened.
        activated(string),
        toggled(tuple<string, bool>),
        /// Debounced 150 ms.
        input(tuple<string, string>),
        submitted(tuple<string, string>),
        selected(tuple<string, list<string>>),
        expanded(tuple<string, bool>),
        shown,
        hidden,
        /// A key the host does not keep, while the panel is focused.
        key(key-event),
        /// Milliseconds since the panel's last tick, for a panel with `tick_ms`. At most 20 a
        /// second, and one at a time: a tick falling due while the plugin still has the last
        /// one is dropped and counted, never queued, so a slow plugin falls behind the clock
        /// rather than being handed a backlog late. A tick is an ordinary call and has the
        /// ordinary 100 ms deadline.
        tick(u32),
    }

    on-event: func(panel: string, event: panel-event);
}
