package fastedit:editor@1.1.0;

/// A plugin for fastedit: a kiln extension with the editor's own imports.
///
/// API 1.1, a preview, as is the `kiln:extension` world it includes: incompatible changes may come
/// in any release until they are declared stable. Released minors are frozen in `released/`; a
/// 1.1 change to them is additive only (new interfaces and functions, never a new case or field
/// in an existing type), and the host serves each released minor's world.
world editor-extension {
    include kiln:extension/extension@1.1.0;

    import buffer;
    import decorations;
    import diagnostics;
    import formatting;
    import lsp;
    import status;
}

/// An editor plugin that runs background jobs: the editor world, with kiln's jobs interfaces, as
/// `kiln:extension`'s `jobs-extension` adds them to `extension`. Its imports link only for a
/// plugin with the `jobs` capability, and a plugin with it is checked against this world, so it
/// exports both handlers. A job runs in a worker store, a second instance without `init`, whose
/// editor imports work under the plugin's grants as the interactive instance's do.
world jobs-editor-extension {
    include editor-extension;

    import kiln:extension/jobs@1.1.0;
    import kiln:extension/job-context@1.1.0;

    export kiln:extension/job-runner@1.1.0;
    export kiln:extension/job-handler@1.1.0;
}
