# A JetBrains HTTP Client / REST Client request file.
// Both # and // start a comment.

@host = api.example.com
@token = secret-token
@contentType = application/json

### List users

# @name listUsers
# @no-redirect
GET https://{{host}}/v1/users?page=1
    &limit=20
    &sort=name#results HTTP/1.1
Accept: {{contentType}}
Authorization: Bearer {{token}}

> {%
  client.test("listed", function () {
    client.assert(response.status === 200, "status");
  });
  client.global.set("firstId", response.body[0].id);
%}

### Create a user

# @name createUser
POST https://{{host}}/v1/users HTTP/1.1
Content-Type: application/json
X-Request-Id: {{$uuid}}

{
  "id": "{{$uuid}}",
  "name": "Alice",
  "active": true,
  "tags": ["admin", "ops"]
}

>> ./responses/created.json

### Update a user from an XML body

PUT https://{{host}}/v1/users/{{firstId}}
Content-Type: application/xml

<?xml version="1.0" encoding="UTF-8"?>
<user id="42">
  <name>Alice</name>
</user>

>>! ./responses/updated.xml

### Query with GraphQL

POST https://{{host}}/graphql
Content-Type: application/json
X-REQUEST-TYPE: GraphQL

query GetUser($id: ID!) {
  user(id: $id) {
    name
    email
  }
}

{
  "id": "{{firstId}}"
}

### Sign in with a form

< {%
  request.variables.set("stamp", Date.now().toString());
%}

POST https://{{host}}/oauth/token
Content-Type: application/x-www-form-urlencoded

grant_type=password&
username=alice&
password={{token}}

> ./scripts/save-token.js

### Upload a file

POST https://{{host}}/v1/files
Content-Type: multipart/form-data; boundary=Boundary

--Boundary
Content-Disposition: form-data; name="title"

Quarterly report
--Boundary
Content-Disposition: form-data; name="file"; filename="report.csv"
Content-Type: text/csv

< ./data/report.csv
--Boundary--

### Send a body from a file

< ./scripts/sign.js
PATCH https://{{host}}/v1/settings
Content-Type: application/json

< ./bodies/settings.json

### Chain other requests

import ./auth.http
run #createUser (@host=staging.example.com)
run ./smoke.http

DELETE https://{{host}}/v1/users/{{firstId}}

### A pasted response

HTTP/1.1 200 OK
Content-Type: application/json
Cache-Control: no-cache

{
  "ok": true
}
